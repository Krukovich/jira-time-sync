{
  "name": "jira-time-sync",
  "version": "1.0.0",
  "main": "dist/main/main.cjs",
  "type": "module",
  "scripts": {
    "build:main": "webpack --config webpack.main.config.js",
    "build:preload": "webpack --config webpack.preload.config.js",
    "build:renderer": "webpack --config webpack.config.js",
    "build": "yarn build:main && yarn build:preload && yarn build:renderer",
    "watch:main": "webpack --config webpack.main.config.js --watch",
    "watch:preload": "webpack --config webpack.preload.config.js --watch",
    "watch:renderer": "webpack --watch",
    "start": "yarn build && electron .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "prepare": "husky",
    "dev:renderer": "webpack serve --config webpack.config.js",
    "dev:electron": "wait-on dist/main/main.cjs dist/preload/preload.cjs http://localhost:3000 && electron .",
    "dev": "concurrently -k -n main,preload,renderer,electron -c blue,green,magenta,yellow \"yarn watch:main\" \"yarn watch:preload\" \"yarn dev:renderer\" \"yarn dev:electron\""
  },
  "author": "Krukovich Alexey",
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx}": [
      "npm run format",
      "npm run lint"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.7.0",
    "electronmon": "^2.0.4",
    "eslint-config-prettier": "^10.1.8",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "specifier-resolution-node": "^1.1.4",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "tsc-alias": "^1.9.7",
    "tsc-watch": "^7.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "wait-on": "^9.5.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.12.0",
    "i18next": "^26.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "zustand": "^5.0.15"
  }
}
